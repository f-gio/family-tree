{
  "hosting": {
    "public": "dist-recette",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/.git/**",
      "**/.firebase/**",
      "**/tests/**",
      "**/scripts/**",
      "**/*.log",
      "**/*.md",
      "**/firestore.rules",
      "**/AGENTS.md",
      "**/package.json",
      "**/package-lock.json"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "emulators": {
    "firestore": {
      "port": 8080
    },
    "auth": {
      "port": 9099
    }
  }
}
