rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function hasAccessDocument() {
      return exists(/databases/$(database)/documents/settings/access);
    }

    function isPrimaryAdmin() {
      return signedIn()
        && hasAccessDocument()
        && get(/databases/$(database)/documents/settings/access).data.primaryAdminUid == request.auth.uid;
    }

    function isApproved() {
      return isPrimaryAdmin()
        || (signedIn()
          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved');
    }

    function isAdmin() {
      return isPrimaryAdmin()
        || (isApproved()
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }

    function isBootstrapOwnerAfter() {
      return signedIn()
        && !hasAccessDocument()
        && existsAfter(/databases/$(database)/documents/settings/access)
        && getAfter(/databases/$(database)/documents/settings/access).data.primaryAdminUid == request.auth.uid;
    }

    function validGenealogyDate(value) {
      return value is map && value.type in ['exact', 'year', 'about', 'between', 'unknown']
        && (value.type == 'unknown'
          || (value.type == 'exact' && value.value is string && value.value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
          || ((value.type == 'year' || value.type == 'about') && value.year is int && value.year >= 1 && value.year <= 9999)
          || (value.type == 'between' && value.from is int && value.to is int && value.from >= 1 && value.to <= 9999 && value.from <= value.to));
    }

    function validPerson() {
      return (!('photoUrl' in request.resource.data)
          || (request.resource.data.photoUrl is string && request.resource.data.photoUrl.size() <= 8 * 1024))
        && (!('birthDateInfo' in request.resource.data) || validGenealogyDate(request.resource.data.birthDateInfo))
        && (!('deathDateInfo' in request.resource.data) || validGenealogyDate(request.resource.data.deathDateInfo));
    }

    function validUpdatedBy() {
      return !('updatedBy' in request.resource.data)
        || request.resource.data.updatedBy == request.auth.uid;
    }

    function validFamily() {
      return request.resource.data.partnerIds is list
        && request.resource.data.childIds is list
        && request.resource.data.partnerIds.size() >= 1
        && request.resource.data.partnerIds.size() <= 2
        && request.resource.data.partnerIds.toSet().size() == request.resource.data.partnerIds.size()
        && request.resource.data.childIds.toSet().size() == request.resource.data.childIds.size()
        && !request.resource.data.partnerIds.hasAny(request.resource.data.childIds)
        && (!('relationType' in request.resource.data) || request.resource.data.relationType in ['marriage', 'civil', 'partner', 'other', 'unknown'])
        && (!('unionDateInfo' in request.resource.data) || validGenealogyDate(request.resource.data.unionDateInfo))
        && (!('unionPlace' in request.resource.data) || request.resource.data.unionPlace is string)
        && (!('endType' in request.resource.data) || request.resource.data.endType in ['none', 'separation', 'divorce', 'other', 'unknown'])
        && (!('endDateInfo' in request.resource.data) || validGenealogyDate(request.resource.data.endDateInfo))
        && (!('endPlace' in request.resource.data) || request.resource.data.endPlace is string)
        && (!('parentChildLinks' in request.resource.data) || (request.resource.data.parentChildLinks is list && request.resource.data.parentChildLinks.size() <= 200));
    }

    function validChunk() {
      return request.resource.data.documentId is string
        && request.resource.data.version is string
        && request.resource.data.index is int
        && request.resource.data.index >= 0
        && request.resource.data.data is bytes
        && request.resource.data.data.size() <= 700 * 1024;
    }

    function validUser() {
      return request.resource.data.email is string
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 60
        && request.resource.data.photo is string
        && request.resource.data.photo.size() <= 8 * 1024
        && request.resource.data.role in ['member', 'admin']
        && request.resource.data.status in ['pending', 'approved', 'suspended', 'rejected'];
    }

    // Dossiers de démarche : recherches, correspondances, rendez-vous,
    // formalités et consultation d'archives, avec chronologie d'actions.
    function validProcedure() {
      return request.resource.data.title is string
        && request.resource.data.title.size() >= 1
        && request.resource.data.title.size() <= 160
        && request.resource.data.type in ['research', 'correspondence', 'appointment', 'administrative', 'archive', 'call', 'online', 'other']
        && request.resource.data.status in ['prepare', 'progress', 'waiting', 'reply', 'appointment', 'done', 'abandoned']
        && (!('objective' in request.resource.data) || request.resource.data.objective is string)
        && (!('organization' in request.resource.data) || request.resource.data.organization is string)
        // « service » est un token réservé du langage des règles : seul un accès
        // crochets data['service'] permet de lire ce champ sans casser le parseur.
        && (!('service' in request.resource.data) || request.resource.data['service'] is string)
        && (!('contactName' in request.resource.data) || request.resource.data.contactName is string)
        && (!('email' in request.resource.data) || request.resource.data.email is string)
        && (!('phone' in request.resource.data) || request.resource.data.phone is string)
        && (!('place' in request.resource.data) || request.resource.data.place is string)
        && (!('nextAction' in request.resource.data) || request.resource.data.nextAction is string)
        && (!('nextActionDate' in request.resource.data) || request.resource.data.nextActionDate == ''
          || (request.resource.data.nextActionDate is string && request.resource.data.nextActionDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        && (!('notes' in request.resource.data) || request.resource.data.notes is string)
        && (!('result' in request.resource.data) || request.resource.data.result is string)
        && (!('personIds' in request.resource.data) || (request.resource.data.personIds is list
          && request.resource.data.personIds.size() <= 50
          && request.resource.data.personIds.toSet().size() == request.resource.data.personIds.size()));
    }

    function validProcedureAction() {
      return request.resource.data.type in ['email-sent', 'email-received', 'appointment-requested', 'appointment-confirmed', 'call', 'archive-visit', 'registry-consult', 'online-search', 'note', 'document-sent', 'document-received', 'other']
        && (!('date' in request.resource.data) || request.resource.data.date == ''
          || (request.resource.data.date is string && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        && (!('direction' in request.resource.data) || request.resource.data.direction in ['none', 'sent', 'received'])
        && (!('title' in request.resource.data) || request.resource.data.title is string)
        && (!('text' in request.resource.data) || request.resource.data.text is string)
        && (!('author' in request.resource.data) || request.resource.data.author is string)
        && (!('time' in request.resource.data) || request.resource.data.time == ''
          || (request.resource.data.time is string && request.resource.data.time.matches('^[0-9]{2}:[0-9]{2}(:[0-9]{2})?$')))
        && (!('emailFrom' in request.resource.data) || request.resource.data.emailFrom is string)
        && (!('emailTo' in request.resource.data) || request.resource.data.emailTo is string)
        && (!('emailSubject' in request.resource.data) || request.resource.data.emailSubject is string)
        && (!('emailFull' in request.resource.data) || request.resource.data.emailFull is string);
    }

    function adminMayManage(userId) {
      return !hasAccessDocument()
        || userId != get(/databases/$(database)/documents/settings/access).data.primaryAdminUid;
    }

    // Configuration minimale lisible avant connexion pour afficher l'inscription.
    match /publicConfig/auth {
      allow read: if true;
      allow create: if isBootstrapOwnerAfter() || isAdmin();
      allow update: if isAdmin();
      allow delete: if false;
    }

    // Le premier compte déjà créé qui se connecte initialise l'administrateur principal.
    match /settings/access {
      allow read: if signedIn();
      allow create: if signedIn()
        && !hasAccessDocument()
        && request.resource.data.primaryAdminUid == request.auth.uid;
      allow update, delete: if false;
    }

    match /users/{userId} {
      allow get: if signedIn() && (userId == request.auth.uid || isAdmin());
      allow list: if isAdmin() || (isApproved() && resource.data.status == 'approved');
      allow create: if signedIn() && userId == request.auth.uid && validUser() && (
        (request.resource.data.email == request.auth.token.email
          && request.resource.data.role == 'member'
          && request.resource.data.status == 'pending')
        || (isBootstrapOwnerAfter()
          && request.resource.data.role == 'admin'
          && request.resource.data.status == 'approved')
        || (isPrimaryAdmin()
          && request.resource.data.role == 'admin'
          && request.resource.data.status == 'approved')
      );
      allow update: if validUser() && (
        (isAdmin() && adminMayManage(userId))
        || (signedIn()
          && userId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'photo', 'updatedAt']))
      );
      allow delete: if false;
    }

    // L'arbre est accessible uniquement aux comptes approuvés.
    match /people/{personId} {
      allow read, delete: if isApproved();
      allow create, update: if isApproved() && validPerson() && validUpdatedBy();
    }

    // Une famille relie un ou deux partenaires à leurs enfants.
    match /families/{familyId} {
      allow read, delete: if isApproved();
      allow create, update: if isApproved() && validFamily();
    }

    // Métadonnées des actes, photos et autres sources familiales.
    match /documents/{documentId} {
      allow read, create, update, delete: if isApproved();
    }

    // Contenu binaire des fichiers, découpé en blocs inférieurs à 1 Mio.
    // Cette solution utilise uniquement Firestore et reste compatible avec Spark.
    match /documentChunks/{chunkId} {
      allow read, delete: if isApproved();
      allow create, update: if isApproved() && validChunk();
    }

    // Tâches de recherche et démarches à effectuer.
    match /tasks/{taskId} {
      allow read, create, update, delete: if isApproved();
    }

    // Dossiers de démarche (La Nostra Storia — Démarches) : accessibles aux
    // comptes approuvés, comme people/families/documents/tasks.
    match /procedures/{dossierId} {
      allow read: if isApproved();
      allow create, update: if isApproved() && validProcedure() && validUpdatedBy();
      allow delete: if isApproved();
      // Chronologie d'un dossier : création rattachée à un dossier existant
      // (pas d'action orpheline), en écriture comme en lecture.
      match /actions/{actionId} {
        allow read: if isApproved();
        allow create: if isApproved() && validProcedureAction() && validUpdatedBy()
          && exists(/databases/$(database)/documents/procedures/$(dossierId));
        // Sur une suppression, request.resource.data est null : la validation
        // de contenu ne s'applique qu'à la mise à jour (modèle : people).
        allow update: if isApproved() && validProcedureAction() && validUpdatedBy();
        allow delete: if isApproved();
      }
    }

    // Aucun autre document Firestore n'est exposé.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
