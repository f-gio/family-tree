// CANDIDAT NON PUBLIÉ — extension additive à intégrer à firestore.rules après validation.
// Remplacer uniquement validGenealogyDate(value) par cette version; toutes les
// autres règles restent strictement identiques au fichier courant.
function validGenealogyDate(value) {
  return value is map && value.type in ['exact', 'year', 'about', 'before', 'after', 'between', 'unknown']
    && (value.type == 'unknown'
      || (value.type == 'exact' && value.value is string && value.value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
      || ((value.type == 'year' || value.type == 'about') && value.year is int && value.year >= 1 && value.year <= 9999)
      || ((value.type == 'before' || value.type == 'after') && (
        (value.value is string && value.value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
        || (value.year is int && value.year >= 1 && value.year <= 9999)))
      || (value.type == 'between' && value.from is int && value.to is int && value.from >= 1 && value.to <= 9999 && value.from <= value.to));
}
